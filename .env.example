## MediaCrawler (ultra-ai-backend) example environment file
# Copy this to `.env` and fill values before running the server.

# ======================
# Database Configuration
# ======================

# Environment: production or development
ENVIRONMENT=production

# Production Database (used when ENVIRONMENT=production)
PROD_DB_USER=root
PROD_DB_PWD=your_password
PROD_DB_URI=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_NAME=media_crawler

# Development Database (used when ENVIRONMENT=development)
DEV_DB_USER=root
DEV_DB_PWD=your_password
DEV_DB_URI=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_NAME=media_crawler

# Fallback: direct connection string (optional, used if set)
# Format: mysql://user:password@host:port/database
RELATION_DB_URL=mysql://root:password@127.0.0.1:3306/media_crawler

# Redis Configuration
REDIS_DB_HOST=127.0.0.1
REDIS_DB_PWD=123456

# ======================
# Storage Configuration
# ======================

# Qiniu (七牛云) storage credentials
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET_NAME=your_qiniu_bucket
QINIU_CDN_DOMAIN=your_qiniu_cdn_domain

# Tencent COS storage credentials (optional)
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_BUCKET_NAME=your_tencent_bucket
TENCENT_CDN_DOMAIN=your_tencent_cos_cdn_domain
TENCENT_REGION=ap-guangzhou

# ======================
# AI/LLM Configuration
# ======================

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key

# 评论分析 LLM（OpenAI 兼容；换厂商/模型只改这三行，代码不动）
# 不配置时回退到上面的 DeepSeek（base_config.py 中的默认值）
# 示例：百度千帆 ERNIE -> LLM_BASE_URL=https://qianfan.baidubce.com/v2  LLM_MODEL=ernie-4.5-turbo-128k
#       阿里百炼 Qwen  -> LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-flash
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://qianfan.baidubce.com/v2
LLM_MODEL=ernie-4.5-turbo-128k

# Analysis thread count
ANALYSIS_THREAD_NUM=6

# ======================
# Application Configuration
# ======================

# Data save option: db, csv, or json
SAVE_DATA_OPTION=db

# Platform: xhs, douyin, kuaishou, bilibili, weibo
PLATFORM=xhs

# Login type: qrcode, phone, or cookie
LOGIN_TYPE=qrcode

# Headless browser mode (true/false)
HEADLESS=true

# Enable IP proxy (true/false)
ENABLE_IP_PROXY=false

# IP proxy pool count
IP_PROXY_POOL_COUNT=2

# IP proxy provider name
IP_PROXY_PROVIDER_NAME=kuaidaili

# User data directory pattern (%s will be replaced by platform name)
USER_DATA_DIR=%s_user_data_dir

# ======================
# Security Configuration
# ======================

# JWT Secret Key (generate a random string)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Admin Password (for admin operations via x-admin-password header)
ADMIN_PASSWORD=your_admin_password

# ======================
# Notes
# ======================
# - Do NOT commit your real secrets to version control
# - Keep a private `.env` file with real values
# - All modules call `load_dotenv()` so values from `.env` will be loaded automatically
# - Docker Compose will load this file via `env_file` directive
JWT_SECRET_KEY=a-very-strong-secret-key-123456

SHOP_API_KEY=shop-key